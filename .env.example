# Debe coincidir con TENANT_BASE_DOMAIN del backend. En producción, por ejemplo:
# app.colegios.example.com (tenant: <slug>.app.colegios.example.com)
VITE_TENANT_BASE_DOMAIN=localhost
VITE_TENANT_SCHEME=http
VITE_TENANT_PORT=5173
# Estos hosts deben corresponder a CENTRAL_DOMAINS del backend.
VITE_CENTRAL_HOSTS=localhost,127.0.0.1

# Laravel Reverb. La key es pública; el secreto vive exclusivamente en backend.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

VITE_APP_VERSION=0.1.0
VITE_APP_THEME_NAME=Colegio SaaS
